# Django Backend
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api,.trycloudflare.com
DJANGO_TIME_ZONE=Africa/Lagos

# Postgres
POSTGRES_DB=corpershub_db
POSTGRES_USER=db_user
POSTGRES_PASSWORD=db_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Valkey
VALKEY_URL=redis://valkey:6379/0
REDIS_URL=redis://valkey:6379/0


# Frontend
WEB_URL=http://localhost:3200
COMPANY_VERIFICATION_ADMIN_EMAIL=admin@corpershub.ng

# JWT
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=14
AUTH_REFRESH_COOKIE_DEFAULT_MAX_AGE=1209600
AUTH_REFRESH_COOKIE_REMEMBER_MAX_AGE=2592000
FIELD_ENCRYPTION_KEY=FF9nHsWXW9oOUu9U2Qgup4wyDv9pdo8HGc_Vn3q9AmY=


# CORS
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=http://localhost:3200,http://127.0.0.1:3200,https://dev.corpershub.ng,https://corpershub.ng
CORS_ALLOW_CREDENTIALS=True
CSRF_TRUSTED_ORIGINS=http://localhost:3200,http://127.0.0.1:3200,https://dev.corpershub.ng,https://corpershub.ng

# Auth cookies
AUTH_REFRESH_COOKIE_NAME=corpershub_refresh
AUTH_REFRESH_COOKIE_PATH=/
AUTH_REFRESH_COOKIE_SAMESITE=Lax
AUTH_REFRESH_COOKIE_SECURE=False
AUTH_REFRESH_COOKIE_DOMAIN=

# S3-compatible media storage (MinIO locally)
AWS_STORAGE_BUCKET_NAME=corpershub-local-media
AWS_S3_REGION_NAME=us-east-1
AWS_S3_ENDPOINT_URL=http://minio:9000
AWS_S3_PUBLIC_ENDPOINT_URL=http://localhost:9200
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_S3_CUSTOM_DOMAIN=localhost:9200/corpershub-local-media
AWS_S3_ADDRESSING_STYLE=path
AWS_S3_URL_PROTOCOL=http:
AWS_S3_FILE_OVERWRITE=True
AWS_USE_S3_STORAGE=True


# Flutterwave local Docker Compose setup
# Local billing uses the Flutterwave v3 sandbox configuration.
FLUTTERWAVE_API_VERSION=v3
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_CLIENT_ID=
FLUTTERWAVE_CLIENT_SECRET=
FLUTTERWAVE_ENCRYPTION_KEY=
FLUTTERWAVE_WEBHOOK_URL=
FLUTTERWAVE_WEBHOOK_PATH=/api/payments/webhooks/flutterwave/
CLOUDFLARE_TUNNEL_URL_FILE=
FLUTTERWAVE_WEBHOOK_SECRET_HASH=
FLUTTERWAVE_API_BASE_URL=https://developersandbox-api.flutterwave.com
FLUTTERWAVE_V3_API_BASE_URL=https://developersandbox-api.flutterwave.com/v3
FLUTTERWAVE_TOKEN_URL=https://idp.flutterwave.com/realms/flutterwave/protocol/openid-connect/token
FLUTTERWAVE_SETTLEMENT_BANK_NAME=
FLUTTERWAVE_SETTLEMENT_ACCOUNT_NUMBER=


# Verification
VERIFICATION_SERVICE=prembly
DIKRIPT_API_BASE_URL=https://api.dikript.com
DIKRIPT_NIN_API_URL=/dikript/verification/api/v1/getnin
DIKRIPT_CAC_API_URL=/dikript/verification/api/v1/getcacbasic
DIKRIPT_PUBLIC_KEY=
DIKRIPT_SECRET_KEY=
DIKRIPT_TIMEOUT_SECONDS=10
DIKRIPT_LOOKUP_CACHE_TIMEOUT_SECONDS=86400
PREMBLY_API_BASE_URL=https://api.prembly.com
PREMBLY_NIN_API_URL=/verification/vnin
PREMBLY_CAC_API_URL=/verification/cac
PREMBLY_API_SECRET_KEY=
PREMBLY_API_PUBLIC_KEY=
PREMBLY_TIMEOUT_SECONDS=60
PREMBLY_LOOKUP_CACHE_TIMEOUT_SECONDS=86400
PREMBLY_WEBHOOK_TOKEN_CACHE_SECONDS=604800
PREMBLY_CAC_COMPANY_TYPE=RC


# Email
# Local development defaults to console email output unless LOCAL_USE_SMTP_EMAIL=True.
# Set LOCAL_USE_SMTP_EMAIL=True only when you want to send real SMTP mail locally.
LOCAL_USE_SMTP_EMAIL=False
LOCAL_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
OTP_EMAIL_FALLBACK_ENABLED=True
OTP_EMAIL_FALLBACK_BACKEND=django.core.mail.backends.console.EmailBackend
OTP_EXPIRY_SECONDS=600
OTP_RESEND_WINDOW_SECONDS=60
OTP_MAX_ATTEMPTS=5
DEFAULT_FROM_EMAIL=noreply@corpershub.ng
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_FROM_EMAIL=info@corpershub.ng
SERVER_EMAIL=info@corpershub.ng
EMAIL_HOST=smtp.hostinger.com
EMAIL_PORT=587
EMAIL_HOST_USER=info@corpershub.ng
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=60
OTP_EMAIL_ASYNC=False

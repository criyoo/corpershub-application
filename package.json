{
  "name": "Corpershub",
  "private": true,
  "workspaces": [
    "apps/web",
    "packages/*"
  ],
  "scripts": {
    "dev": "docker compose up",
    "dev:web": "npm -w apps/web run dev",
    "build:web": "npm -w apps/web run build",
    "lint:web": "npm -w apps/web run lint",
    "test:web": "npm -w apps/web run test"
  },
  "dependencies": {
    "typescript": "^6.0.3",
    "whatwg-encoding": "file:packages/whatwg-encoding"
  },
  "engines": {
    "node": ">=24.18.0",
    "npm": ">=11.16.0"
  }
}
